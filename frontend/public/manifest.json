{
  "manifest_version": 3,
  "name": "Email Reply Generator",
  "version": "0.1.0",
  "description": "Generate AI-powered email replies directly from Gmail and Outlook",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://mail.google.com/*",
    "*://gmail.google.com/*",
    "*://outlook.office.com/*",
    "*://outlook.live.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Email Reply Generator"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*",
        "*://gmail.google.com/*",
        "*://outlook.office.com/*",
        "*://outlook.live.com/*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "options.html"],
      "matches": ["*://mail.google.com/*", "*://gmail.google.com/*", "*://outlook.office.com/*", "*://outlook.live.com/*"]
    }
  ]
}
